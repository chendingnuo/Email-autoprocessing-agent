# ── LLM 配置 ───────────────────────────────────────
# 通义千问 API 密钥（必填）
DASHSCOPE_API_KEY=sk-你的API密钥
LLM_PROVIDER=tongyi
LLM_MODEL=qwen-plus

# ── 邮件服务器配置（Gmail） ────────────────────────
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
EMAIL_ACCOUNT=你的Gmail邮箱@gmail.com
EMAIL_PASSWORD=你的Gmail应用专用密码

# ── Agent 配置 ─────────────────────────────────────
AGENT_LOG_LEVEL=INFO
AGENT_STORAGE_DIR=./data/tasks
AGENT_DATA_DIR=./data
AGENT_HOST=127.0.0.1
AGENT_PORT=8000
