# ── 敏感信息 ─────────────────────────────────────────
# API密钥、邮箱密码等敏感凭据
.env
# 邮箱账号统一配置文件（含密码）
data/email_accounts.json

# ── Python 缓存 ──────────────────────────────────────
__pycache__/
.pytest_cache/
*.pyc
*.pyo
*.pyd
*.egg-info/
dist/
build/

# ── 运行时数据 ───────────────────────────────────────
# 任务执行历史记录（含邮件内容）
data/tasks/
# 邮件附件下载缓存
data/attachments/
# 对话日志文件（含完整 prompt/response）
data/logs/
# Excel 运行时变更（避免 Git 追踪表格数据变动）
data/*.xlsx

# ── 前端依赖（本地自托管）────────────────────────────
static/node_modules/
static/package.json
static/package-lock.json

# ── IDE / 编辑器 ─────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── 开发工具缓存 ─────────────────────────────────────
.playwright-mcp/
dashboard-screenshot.png
